# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Required for any LLM call (M2+). Not needed for M0/M1.
ANTHROPIC_API_KEY=

# Model used for all Claude calls. Never hard-coded elsewhere.
MODEL_NAME=claude-sonnet-5

# Extraction confidence below this forces at least `review`. (Default for the settings table.)
CONFIDENCE_THRESHOLD=0.8

# Default amount-tolerance rule params (seeded into the builtin rule; editable in the DB afterwards).
TOLERANCE_PCT=2.0
TOLERANCE_ABS=50.0

# Optional path overrides (defaults: data/app.db and data/seed.json under the repo root).
# DB_PATH=
# SEED_PATH=
