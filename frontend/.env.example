# Build-time settings for the frontend (Vite). Copy to .env.local only if you need to change them.
#
# VITE_API_BASE: the backend's URL. Leave EMPTY for local development: the app then uses relative /api URLs and the Vite dev
# server proxies them to http://127.0.0.1:8000 (vite.config.ts). On Vercel, set it to the Render service URL, for example
# https://invoice-agent-api.onrender.com (no trailing slash).
VITE_API_BASE=
